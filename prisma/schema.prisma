generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  engineType    = "library"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model booking {
  id              String   @id @db.VarChar(64)
  confirmationCode String  @unique @db.VarChar(32)

  accommodation   String
  rateType        String
  ratePlan        String
  basePriceCents  Int
  currency        String @default("KSH")
  nights          Int
  guests          Int

  addOnsJson      Json
  addOnTotalCents Int

  totalCents      Int

  guestName       String?
  email           String?
  phone           String?
  specialRequests String?

  checkIn DateTime?
  checkOut DateTime?

  status          String   @default("new") // new | confirmed | completed | rejected | cancelled
  paid            Boolean  @default(false)
  source          String   @default("web")

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@map("bookings")
}

model notice {
  id          String   @id @default(cuid())
  message     String
  color       String   @default("#000000")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notices")
}